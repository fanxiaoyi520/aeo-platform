FROM python:3.11.9-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.4.18 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY apps/orchestrator/pyproject.toml apps/orchestrator/
COPY apps/browser/pyproject.toml apps/browser/
COPY packages/shared/pyproject.toml packages/shared/
COPY packages/llm/pyproject.toml packages/llm/
COPY packages/rag/pyproject.toml packages/rag/
COPY apps/api/src apps/api/src
COPY apps/orchestrator/src apps/orchestrator/src
COPY apps/browser/src apps/browser/src
COPY packages/shared/src packages/shared/src
COPY packages/llm/src packages/llm/src
COPY packages/rag/src packages/rag/src
COPY knowledge knowledge
COPY scripts/ingest_knowledge.py scripts/

RUN uv sync --frozen --package aeo-api --no-dev \
    && uv run playwright install-deps chromium \
    && uv run playwright install chromium

COPY apps/api/alembic apps/api/alembic
COPY apps/api/alembic.ini apps/api/

ENV PYTHONPATH=/app/apps/api/src:/app/apps/orchestrator/src:/app/apps/browser/src:/app/packages/shared/src:/app/packages/llm/src:/app/packages/rag/src

WORKDIR /app/apps/api

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "aeo_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
