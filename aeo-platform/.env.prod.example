# Production — copy to .env.prod and replace secrets before deploy.
# Used by: docker compose --env-file .env.prod -f infra/compose/docker-compose.prod.yml

# Application
APP_ENV=production
APP_NAME=aeo-platform
APP_DEBUG=false

# Database (compose interpolates POSTGRES_PASSWORD into DB_URL)
POSTGRES_PASSWORD=change-me-strong-password

# LLM (OpenAI-compatible / company gateway)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Embedding
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=your-api-key-here
EMBED_MODEL=text-embedding-3-small

# Auth (must match between api and web)
AUTH_API_KEY=change-me-production-api-key

# CORS (required in production — web origin only)
CORS_ORIGINS=http://localhost:3000

# Agent limits
AGENT_MAX_CONCURRENT=3
RATE_LIMIT_PER_MINUTE=100

# RAG / Chroma (paths inside api container)
CHROMA_PATH=data/chroma
KNOWLEDGE_PATH=knowledge
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
RAG_USE_HASH_EMBEDDINGS=true
