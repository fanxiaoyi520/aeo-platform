# Application
APP_ENV=development
APP_NAME=aeo-platform
APP_DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DB_URL=postgresql+asyncpg://aeo:aeo_dev_password@localhost:5432/aeo
DB_URL_SYNC=postgresql+psycopg://aeo:aeo_dev_password@localhost:5432/aeo

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible / company gateway)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Embedding
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=your-api-key-here
EMBED_MODEL=text-embedding-3-small

# Auth
AUTH_API_KEY=dev-api-key-change-in-production

# CORS (comma-separated origins; dev defaults to localhost:3000 when empty)
CORS_ORIGINS=

# Agent limits
AGENT_MAX_CONCURRENT=3
RATE_LIMIT_PER_MINUTE=100

# RAG / Chroma
CHROMA_PATH=data/chroma
KNOWLEDGE_PATH=knowledge
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
RAG_USE_HASH_EMBEDDINGS=true

# Browser automation (MS4 — optional; requires `playwright install chromium`)
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_SCREENSHOT_DIR=data/screenshots

# Amazon SP-API (mock skeleton — switch to spapi after P1-03 / MV0-02)
AMAZON_DATA_SOURCE=mock
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_REGION=us-east-1
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
